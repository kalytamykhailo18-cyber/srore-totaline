generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  parentId  Int?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("categories")
}

model Product {
  id              Int      @id @default(autoincrement())
  sku             String   @unique @db.VarChar(50)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  supplierPrice   Decimal  @db.Decimal(14, 2)
  resellerPrice   Decimal  @db.Decimal(14, 2)
  currency        String   @default("ARS") @db.VarChar(3)
  stockStatus     Boolean  @default(true)
  categoryId      Int?
  category        Category? @relation(fields: [categoryId], references: [id])
  imageUrl        String?  @db.VarChar(500)
  localImage      String?  @db.VarChar(255)
  totalineUrl     String?  @db.VarChar(500)
  isManual        Boolean  @default(false)
  active          Boolean  @default(true)
  lastSynced      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

model SyncLog {
  id             Int      @id @default(autoincrement())
  type           String   @db.VarChar(10)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  productsTotal  Int      @default(0)
  productsAdded  Int      @default(0)
  productsUpdated Int     @default(0)
  productsRemoved Int     @default(0)
  errors         Int      @default(0)
  errorDetails   String?  @db.Text

  @@map("sync_logs")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(50)
  value String @db.Text

  @@map("settings")
}

// WhatsApp Inbox
model WhatsAppChat {
  chatId        String   @id @db.VarChar(50)
  contactName   String   @default("") @db.VarChar(100)
  contactPhone  String   @default("") @db.VarChar(20)
  lastMessage   String   @default("") @db.VarChar(200)
  lastMessageAt DateTime @default(now())
  unread        Int      @default(0)
  aiPaused      Boolean  @default(false)
  messages      WhatsAppMessage[]

  @@map("whatsapp_chats")
}

model WhatsAppMessage {
  id        Int      @id @default(autoincrement())
  chatId    String   @db.VarChar(50)
  direction String   @db.VarChar(3) // "in" | "out"
  body      String   @db.Text
  sender    String   @default("") @db.VarChar(30) // "contact" | "human" | "bot"
  mediaType String?  @db.VarChar(20) // "image" | "video" | "audio" | "document"
  mediaUrl  String?  @db.VarChar(500)
  timestamp DateTime @default(now())
  chat      WhatsAppChat @relation(fields: [chatId], references: [chatId])

  @@index([chatId])
  @@map("whatsapp_messages")
}

model QuickReply {
  id        Int      @id @default(autoincrement())
  shortcut  String   @unique @db.VarChar(30)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quick_replies")
}
